<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AutoTranslation.QuestAddon</AssemblyName>
    <RootNamespace>QuestTranslationAddon</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\QuestTranslationAddon\1.6\Assemblies\</OutputPath>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.3.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AutoTranslation">
      <HintPath>..\..\1.6\Assemblies\AutoTranslation.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AutoTranslation.QuestAddon.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
